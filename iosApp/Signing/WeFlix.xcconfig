// iOS app signing defaults. CI and the paid team use these as-is.
// Local contributors without access to the paid team can override any of
// these by dropping a `Local.xcconfig` into this directory — see
// `Local.xcconfig.sample` for the template.
//
// Indirection via `WEFLIX_IOS_BUNDLE_ID` / `WEFLIX_IOS_ENTITLEMENTS`
// lets Local.xcconfig swap values without touching the other targets'
// xcconfigs.

WEFLIX_IOS_BUNDLE_ID = me.weflix
WEFLIX_IOS_ENTITLEMENTS = WeFlix.entitlements

PRODUCT_BUNDLE_IDENTIFIER = $(WEFLIX_IOS_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = $(WEFLIX_IOS_ENTITLEMENTS)

#include? "Local.xcconfig"
