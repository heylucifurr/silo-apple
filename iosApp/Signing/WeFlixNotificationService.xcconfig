// iOS Notification Service extension signing defaults. CI and the paid
// team use these as-is. Local contributors without access to the paid team
// can override any of these by dropping a `Local.xcconfig` into this
// directory.

WEFLIX_NOTIFICATION_SERVICE_BUNDLE_ID = me.weflix.NotificationService
WEFLIX_NOTIFICATION_SERVICE_ENTITLEMENTS = NotificationService/NotificationService.entitlements

PRODUCT_BUNDLE_IDENTIFIER = $(WEFLIX_NOTIFICATION_SERVICE_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = $(WEFLIX_NOTIFICATION_SERVICE_ENTITLEMENTS)

#include? "Local.xcconfig"
