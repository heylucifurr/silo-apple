// Top Shelf extension signing defaults. CI and the paid team use these
// as-is. Local contributors without access to the paid team can override
// any of these by dropping a `Local.xcconfig` into this directory — see
// `Local.xcconfig.sample` for the template.
//
// Indirection via `WEFLIX_TOPSHELF_BUNDLE_ID` /
// `WEFLIX_TOPSHELF_ENTITLEMENTS` lets Local.xcconfig swap values
// without touching the other targets' xcconfigs.

WEFLIX_TOPSHELF_BUNDLE_ID = me.weflix.topshelf
WEFLIX_TOPSHELF_ENTITLEMENTS = TopShelf/TopShelf.entitlements
WEFLIX_USER_INDEPENDENT_KEYCHAIN = YES

PRODUCT_BUNDLE_IDENTIFIER = $(WEFLIX_TOPSHELF_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = $(WEFLIX_TOPSHELF_ENTITLEMENTS)

#include? "Local.xcconfig"
