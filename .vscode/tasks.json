{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "WeFlix: Generate Xcode project",
      "type": "shell",
      "command": "xcodegen",
      "args": [
        "generate"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "problemMatcher": []
    },
    {
      "label": "WeFlix: Build iOS",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "build",
        "-project",
        "WeFlix.xcodeproj",
        "-scheme",
        "WeFlix",
        "-destination",
        "generic/platform=iOS Simulator",
        "-derivedDataPath",
        ".deriveddata",
        "CODE_SIGN_IDENTITY=",
        "CODE_SIGNING_ALLOWED=NO"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "dependsOn": "WeFlix: Generate Xcode project",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$swiftc"
      ]
    },
    {
      "label": "WeFlix: Build tvOS",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "build",
        "-project",
        "WeFlix.xcodeproj",
        "-scheme",
        "WeFlixTV",
        "-destination",
        "generic/platform=tvOS Simulator",
        "-derivedDataPath",
        ".deriveddata",
        "CODE_SIGN_IDENTITY=",
        "CODE_SIGNING_ALLOWED=NO"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "dependsOn": "WeFlix: Generate Xcode project",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [
        "$swiftc"
      ]
    },
    {
      "label": "WeFlix: Build macOS",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "build",
        "-project",
        "WeFlix.xcodeproj",
        "-scheme",
        "WeFlixMac",
        "-destination",
        "platform=macOS",
        "-derivedDataPath",
        ".deriveddata",
        "CODE_SIGN_IDENTITY=",
        "CODE_SIGNING_ALLOWED=NO"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "dependsOn": "WeFlix: Generate Xcode project",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [
        "$swiftc"
      ]
    },
    {
      "label": "WeFlix: Test iOS",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "test",
        "-project",
        "WeFlix.xcodeproj",
        "-scheme",
        "WeFlix",
        "-destination",
        "${input:iosTestDestination}",
        "-derivedDataPath",
        ".deriveddata",
        "CODE_SIGN_IDENTITY=-",
        "CODE_SIGNING_ALLOWED=YES"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "dependsOn": "WeFlix: Generate Xcode project",
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$swiftc"
      ]
    }
  ],
  "inputs": [
    {
      "id": "iosTestDestination",
      "type": "promptString",
      "description": "Installed iOS Simulator destination",
      "default": "platform=iOS Simulator,name=iPhone 17 Pro"
    }
  ]
}
